.history

# Python cache
__pycache__/
*.py[cod]

# Editor / agent backups and scratch files
*.bak
*.tmp

# Gated match data (see DATA.md) - never commit
data/*
!data/README.md
*.mp4

# Superseded / unverified outputs (all-X predictions from the first attempt)
predictions.csv
results/enhanced_classifier_submission.csv
broadcast_results.csv
tactical_results.csv

# Generated predictions (main.py writes results/<video name>.csv)
results/

# Local-only tools
video_player.py

# Local editor workspace (contains a machine-specific interpreter path)
*.code-workspace
